    "test:e2e": "tsx scripts/run-e2e.ts",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:e2e:only": "vitest run tests/e2e-acceptance.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.11",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
